{
  "$schema": "https://neonred.design/theme-tokens.schema.json",
  "name": "NeonRed Glassmorphism",
  "version": "1.0.0",
  "description": "Single source of truth for the NeonRed UI design system. Use these tokens to build ANY application (calculator, desktop app, dashboard, etc.) with exactly the same look, animations and performance behaviour as NeonRed Soundpad.",
  "darkMode": true,

  "color": {
    "background":      "#050505",
    "backgroundPure":  "#000000",
    "surface":         "#121212",
    "surfaceRaised":   "#1a1a1a",
    "surfaceOverlay":  "#18181b",

    "primary":         "#ef4444",
    "primaryHover":    "#f87171",
    "secondary":       "#be123c",
    "accent":          "#ff0000",
    "accentSoft":      "#ff4d4d",

    "textMain":        "#ffffff",
    "textMuted":       "#9ca3af",
    "textDim":         "#6b7280",

    "border":          "rgba(255,255,255,0.10)",
    "borderStrong":    "rgba(255,255,255,0.20)",

    "primaryBorder":   "rgba(239,68,68,0.30)",
    "primaryBorderStrong": "rgba(239,68,68,0.60)",

    "status": {
      "danger":  "#ef4444",
      "success": "#22c55e",
      "warning": "#f59e0b",
      "info":    "#3b82f6",
      "neutral": "#a1a1aa"
    }
  },

  "glow": {
    "primary":      "0 0 20px rgba(239,68,68,0.6)",
    "primarySoft":  "0 0 30px rgba(239,68,68,0.4)",
    "primaryStrong":"0 0 50px rgba(239,68,68,0.5)",
    "success":      "0 0 30px rgba(34,197,94,0.35)",
    "successStrong":"0 0 50px rgba(34,197,94,0.25)",
    "green":        "0 0 40px rgba(6,182,212,0.4)",
    "emerald":      "0 0 50px rgba(34,197,94,0.2)"
  },

  "shadow": {
    "card":      "0 10px 40px -10px rgba(0,0,0,0.8)",
    "cardNeon":  "0 0 50px rgba(239,68,68,0.18)",
    "modal":     "0 25px 60px -15px rgba(0,0,0,0.9)",
    "modalGreen":"0 0 50px rgba(34,197,94,0.2)"
  },

  "radius": {
    "sm":  "0.5rem",
    "md":  "0.75rem",
    "lg":  "1rem",
    "xl":  "1.25rem",
    "2xl": "1.5rem",
    "3xl": "1.75rem",
    "full": "9999px"
  },

  "font": {
    "sans":     ["Inter", "Vazirmatn", "ui-sans-serif", "system-ui", "sans-serif"],
    "persian":  ["Vazirmatn", "Inter", "sans-serif"],
    "mono":     ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
  },

  "fontWeight": {
    "thin":100,"extralight":200,"light":300,"normal":400,"medium":500,
    "semibold":600,"bold":700,"extrabold":800,"black":900
  },

  "animation": {
    "fadeIn":      { "duration": "300ms", "easing": "ease-out" },
    "slideUp":     { "duration": "0.5s", "easing": "ease-out" },
    "slideInRight":{ "duration": "0.45s", "easing": "cubic-bezier(0.22,1,0.36,1)" },
    "pulseSlow":   { "duration": "3s",   "easing": "cubic-bezier(0.4,0,0.6,1)", "iterations": "infinite" },
    "shimmer":     { "duration": "2s",   "easing": "linear", "iterations": "infinite" },
    "wave":        { "duration": "5s",   "easing": "linear", "iterations": "infinite" },
    "gradientX":   { "duration": "15s",  "easing": "ease",   "iterations": "infinite" },
    "borderFlow":  { "duration": "4s",   "easing": "linear", "iterations": "infinite" },
    "scanline":    { "duration": "4s",   "easing": "linear", "iterations": "infinite" },
    "spin":        { "duration": "1s",   "easing": "linear", "iterations": "infinite" },
    "ping":        { "duration": "1s",   "easing": "cubic-bezier(0,0,0.2,1)", "iterations": "infinite" }
  },

  "backdrop": {
    "blurSm":  "backdrop-blur-md",
    "blurLg":  "backdrop-blur-xl",
    "blur2xl": "backdrop-blur-2xl"
  },

  "messageColors": {
    "error":   { "fg": "#fca5a5", "bg": "rgba(239,68,68,0.12)", "border": "rgba(239,68,68,0.40)", "glow": "0 0 30px rgba(239,68,68,0.35)", "icon": "AlertTriangle" },
    "success": { "fg": "#86efac", "bg": "rgba(34,197,94,0.12)",  "border": "rgba(34,197,94,0.40)",  "glow": "0 0 30px rgba(34,197,94,0.30)", "icon": "CheckCircle" },
    "warning": { "fg": "#fcd34d", "bg": "rgba(245,158,11,0.12)", "border": "rgba(245,158,11,0.40)", "glow": "0 0 30px rgba(245,158,11,0.30)", "icon": "AlertTriangle" },
    "info":    { "fg": "#93c5fd", "bg": "rgba(59,130,246,0.12)", "border": "rgba(59,130,246,0.40)", "glow": "0 0 30px rgba(59,130,246,0.30)", "icon": "Info" },
    "accent":  { "fg": "#fca5a5", "bg": "rgba(239,68,68,0.12)",  "border": "rgba(239,68,68,0.40)",  "glow": "0 0 30px rgba(239,68,68,0.35)", "icon": "Zap" }
  },

  "performance": {
    "lowPowerFpsThreshold": 35,
    "recoverFpsThreshold": 50,
    "backgroundSuspendsRaf": true,
    "memoizeHeavyCards": true,
    "useContentVisibility": true,
    "useContainment": "layout paint style"
  }
}
