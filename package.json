{
  "name": "game-installer",
  "version": "1.0.0",
  "description": "Game Installer - automatically detect, extract and install multi-part cracked games",
  "author": "Game Installer",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "lucide-react": "^0.460.0",
    "node-7z": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "windows-shortcuts": "^0.1.6"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.gameinstaller.app",
    "productName": "Game Installer",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/7zip-bin/**",
      "**/node_modules/windows-shortcuts/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
